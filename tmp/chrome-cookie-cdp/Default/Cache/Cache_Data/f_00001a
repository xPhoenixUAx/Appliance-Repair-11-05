:root {
  --ink: #101418;
  --muted: #647078;
  --paper: #f6f3ee;
  --porcelain: #fbfbf8;
  --steel: #d9e2e4;
  --graphite: #182024;
  --graphite-2: #263036;
  --teal: #1f8d8a;
  --teal-deep: #0d5f62;
  --copper: #c27845;
  --line: rgba(16, 20, 24, .13);
  --shadow: 0 24px 80px rgba(9, 15, 18, .14);
  --radius: 8px;
  --max: 1180px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 96px; }
body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--ink);
  background:
    linear-gradient(90deg, rgba(16, 20, 24, .035) 1px, transparent 1px) 0 0 / 42px 42px,
    radial-gradient(circle at 80% 8%, rgba(31, 141, 138, .11), transparent 34%),
    var(--paper);
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .42;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='220' height='220' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
  mix-blend-mode: multiply;
  z-index: 4;
}

body.menu-open { overflow: hidden; }
img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
p { color: var(--muted); line-height: 1.75; }
.site-main { overflow: hidden; }
button, a, summary { -webkit-tap-highlight-color: transparent; }

.container { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; }
.narrow { width: min(840px, calc(100% - 40px)); margin: 0 auto; }
.section { padding: 108px 0; position: relative; }
.section-tight { padding: 72px 0; }
.band-dark { background: var(--graphite); color: var(--porcelain); }
.band-dark p, .band-dark .eyebrow { color: rgba(251, 251, 248, .72); }
.eyebrow {
  display: none;
  color: var(--teal-deep);
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .11em;
  text-transform: uppercase;
}
h1, h2, h3 { margin: 0; line-height: 1.02; letter-spacing: 0; }
h1 { font-family: "Instrument Serif", Georgia, serif; font-size: clamp(2.2rem, 6.3vw, 5.4rem); font-weight: 500; }
h2 { font-family: "Instrument Serif", Georgia, serif; font-size: clamp(2rem, 3.7vw, 3.85rem); font-weight: 500; }
h3 { font-size: clamp(1.15rem, 2vw, 1.55rem); }
.lead { font-size: clamp(1.05rem, 2vw, 1.32rem); max-width: 720px; }
.section-head { display: grid; grid-template-columns: 1fr .78fr; gap: 42px; align-items: end; margin-bottom: 44px; }

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  transition: background .35s ease, border-color .35s ease, transform .35s ease;
  border-bottom: 1px solid transparent;
}
.site-header.is-scrolled {
  background: rgba(246, 243, 238, .9);
  backdrop-filter: blur(18px);
  border-color: rgba(16, 20, 24, .09);
}
.nav-shell {
  width: min(1280px, calc(100% - 28px));
  margin: 0 auto;
  height: 78px;
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 28px;
  align-items: center;
}
.brand { display: inline-flex; align-items: center; gap: 12px; font-weight: 900; }
.brand-lockup {
  display: grid;
  gap: 3px;
  line-height: 1;
}
.brand-name {
  position: relative;
  display: inline-block;
  font-family: "Instrument Serif", Georgia, serif;
  font-size: 1.34rem;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1;
  color: var(--ink);
}
.brand-descriptor {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--teal-deep);
  font-size: .55rem;
  font-weight: 900;
  letter-spacing: .13em;
  text-transform: uppercase;
  white-space: nowrap;
}
.brand-descriptor::before {
  content: "";
  width: 28px;
  height: 1px;
  background: var(--copper);
  transform: scaleX(.64);
  transform-origin: left;
  transition: transform .24s ease;
}
.brand:hover .brand-descriptor::before {
  transform: scaleX(1);
}
.site-footer .brand-name {
  color: var(--porcelain);
}
.site-footer .brand-descriptor {
  color: rgba(251,251,248,.62);
}
.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  background: var(--graphite);
  color: var(--porcelain);
  border: 1px solid rgba(255,255,255,.16);
  transition: transform .28s ease, background .28s ease;
}
.brand:hover .brand-mark { transform: rotate(-6deg) scale(1.04); background: var(--teal-deep); }
.desktop-nav { display: flex; justify-content: center; gap: 8px; align-items: center; }
.desktop-nav a,
.nav-dropdown__trigger {
  padding: 10px 14px;
  color: rgba(16, 20, 24, .7);
  font-weight: 760;
  border-bottom: 1px solid transparent;
}
.desktop-nav a:hover,
.desktop-nav .is-active,
.nav-dropdown.is-active .nav-dropdown__trigger,
.nav-dropdown:hover .nav-dropdown__trigger,
.nav-dropdown:focus-within .nav-dropdown__trigger {
  color: var(--ink);
  border-color: var(--copper);
}
.nav-dropdown {
  position: relative;
}
.nav-dropdown__trigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.nav-dropdown__trigger svg {
  transition: transform .22s ease;
}
.nav-dropdown:hover .nav-dropdown__trigger svg,
.nav-dropdown:focus-within .nav-dropdown__trigger svg {
  transform: rotate(180deg);
}
.nav-dropdown__menu {
  position: absolute;
  top: calc(100% + 14px);
  left: 50%;
  width: 260px;
  padding: 10px;
  background: rgba(251,251,248,.96);
  border: 1px solid rgba(16,20,24,.12);
  box-shadow: 0 24px 70px rgba(9,15,18,.14);
  backdrop-filter: blur(18px);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 8px);
  transition: opacity .22s ease, transform .22s ease;
}
.nav-dropdown__menu::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -16px;
  height: 16px;
}
.nav-dropdown:hover .nav-dropdown__menu,
.nav-dropdown:focus-within .nav-dropdown__menu {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, 0);
}
.nav-dropdown__menu a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border-bottom: 0;
  color: var(--graphite-2);
}
.nav-dropdown__menu a:hover {
  background: rgba(31,141,138,.08);
  color: var(--ink);
}
.nav-phone, .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 46px;
  padding: 0 18px;
  border: 1px solid var(--line);
  font-weight: 850;
  transition: transform .24s ease, box-shadow .24s ease, background .24s ease, border-color .24s ease, color .24s ease;
}
.nav-phone:hover, .btn:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(9,15,18,.14); }
.btn-primary:hover { background: var(--teal-deep); border-color: var(--teal-deep); }
.btn-light:hover { border-color: rgba(194,120,69,.5); }
.btn-primary { background: var(--graphite); color: var(--porcelain); border-color: var(--graphite); }
.btn-light { background: var(--porcelain); color: var(--ink); }
.btn-ghost { background: transparent; color: inherit; }
.menu-toggle, .mobile-close {
  display: none;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}
.mobile-panel { display: none; }

.hero {
  min-height: 100vh;
  padding: 126px 0 70px;
  display: grid;
  align-items: end;
  position: relative;
}
.hero-media {
  position: absolute;
  inset: 0;
  z-index: -2;
}
.hero-media img { width: 100%; height: 100%; object-fit: cover; }
.hero-media::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(246,243,238,.98) 0%, rgba(246,243,238,.86) 34%, rgba(246,243,238,.18) 72%),
    linear-gradient(0deg, var(--paper) 0%, transparent 28%);
}
.hero-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(320px, .62fr); gap: 70px; align-items: end; }
.hero .hero-grid { grid-template-columns: minmax(0, .82fr) minmax(260px, .38fr); }
.hero-grid > *, .page-hero-grid > *, .split > *, .contact-grid > * { min-width: 0; }
.hero-panel { display: grid; gap: 28px; min-width: 0; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.image-frame {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  background: var(--steel);
}
.image-frame img { transition: transform .7s ease, filter .7s ease; }
.image-frame:hover img { transform: scale(1.035); filter: saturate(1.04) contrast(1.02); }
.image-frame::before {
  content: "";
  position: absolute;
  inset: 16px;
  border: 1px solid rgba(255,255,255,.48);
  z-index: 1;
  pointer-events: none;
}
.image-frame::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 40%;
  background: linear-gradient(0deg, rgba(16,20,24,.52), transparent);
  pointer-events: none;
}
.image-frame img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; }

.metric-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.metric { padding: 24px; border-right: 1px solid var(--line); }
.metric:last-child { border-right: 0; }
.metric strong { display: block; font-size: clamp(1.7rem, 4vw, 3.2rem); font-family: "Instrument Serif", Georgia, serif; font-weight: 500; }
.metric span { color: var(--muted); font-weight: 760; }

.quick-intake {
  display: grid;
  grid-template-columns: .72fr 1.28fr;
  gap: 42px;
  align-items: center;
  padding: 34px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.quick-intake__intro h2 {
  font-size: clamp(1.7rem, 3vw, 2.8rem);
}
.quick-intake__intro p {
  margin-bottom: 0;
}
.quick-intake__steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}
.quick-intake__steps div {
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 14px;
  padding: 20px;
  background: rgba(251,251,248,.72);
  transition: transform .24s ease, background .24s ease, border-color .24s ease;
}
.quick-intake__steps div:hover {
  transform: translateY(-3px);
  background: rgba(251,251,248,.92);
}
.quick-intake__steps i {
  color: var(--teal-deep);
}
.quick-intake__steps strong {
  display: block;
  margin-bottom: 6px;
}
.quick-intake__steps p {
  margin: 0;
  font-size: .92rem;
  line-height: 1.55;
}

.split { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: center; }
.service-lanes { display: grid; gap: 24px; }
.lane {
  display: grid;
  grid-template-columns: 54px 1fr auto;
  gap: 20px;
  align-items: center;
  padding: 24px 0;
  border-bottom: 1px solid var(--line);
}
.lane-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  color: var(--teal-deep);
  background: rgba(31,141,138,.1);
  border: 1px solid rgba(31,141,138,.18);
}
.lane { transition: transform .24s ease, background .24s ease; }
.lane:hover { transform: translateX(6px); background: rgba(251,251,248,.44); }
.lane p { margin: 8px 0 0; }
.arrow { color: var(--copper); }

.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
.feature {
  background: rgba(251,251,248,.74);
  padding: 28px;
  min-height: 240px;
}
.feature i { color: var(--teal-deep); margin-bottom: 34px; }
.feature p { margin-bottom: 0; }

.process { counter-reset: step; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.14); }
.step { counter-increment: step; padding: 28px; background: rgba(255,255,255,.045); min-height: 250px; }
.step::before { content: "0" counter(step); display: block; color: var(--copper); font-weight: 900; margin-bottom: 44px; }
.step { transition: background .24s ease, transform .24s ease; }
.step:hover { background: rgba(255,255,255,.075); transform: translateY(-4px); }

.cta-band {
  padding: 54px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 28px;
  align-items: center;
  background: var(--graphite);
  color: var(--porcelain);
  position: relative;
  overflow: hidden;
}
.cta-band::after {
  content: "";
  position: absolute;
  width: 360px;
  height: 360px;
  right: -140px;
  top: -180px;
  background: radial-gradient(circle, rgba(31,141,138,.42), transparent 68%);
}
.cta-band p { color: rgba(251,251,248,.74); }
.cta-band .btn { position: relative; z-index: 1; }

.page-hero { padding: 150px 0 72px; }
.page-hero-grid { display: grid; grid-template-columns: 1fr .86fr; gap: 58px; align-items: end; }
.breadcrumb { color: var(--muted); font-weight: 760; margin-bottom: 20px; }
.service-nav { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
.service-nav a { border: 1px solid var(--line); padding: 11px 14px; font-weight: 820; background: rgba(251,251,248,.58); }
.detail-list { display: grid; gap: 26px; }
.detail-row {
  display: grid;
  grid-template-columns: 58px 1fr;
  gap: 22px;
  padding-bottom: 26px;
  border-bottom: 1px solid var(--line);
}
.detail-row ul, .legal-content ul { margin: 14px 0 0; padding-left: 18px; color: var(--muted); line-height: 1.75; }
.method-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
.method { background: rgba(251,251,248,.74); padding: 28px; }
.method h3 { display: flex; align-items: center; gap: 12px; }
.method { transition: transform .24s ease, background .24s ease; }
.method:hover { transform: translateY(-3px); background: rgba(251,251,248,.92); }
.faq { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
.faq details {
  background: rgba(251,251,248,.8);
  padding: 0 28px;
  overflow: hidden;
  transition: background .24s ease;
}
.faq details:hover, .faq details[open] { background: rgba(251,251,248,.94); }
.faq summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 76px;
  cursor: pointer;
  font-weight: 870;
  list-style: none;
}
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after {
  content: "+";
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  border: 1px solid var(--line);
  color: var(--teal-deep);
  transition: transform .28s ease, background .28s ease;
}
.faq details[open] summary::after {
  transform: rotate(45deg);
  background: rgba(31,141,138,.08);
}
.faq-content {
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: height .36s ease, opacity .24s ease;
}
.faq-content > * {
  margin-top: 0;
  margin-bottom: 24px;
}
.faq details[open] .faq-content {
  opacity: 1;
}

.contact-grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: 52px; }
.contact-list { display: grid; gap: 18px; }
.contact-item { display: flex; gap: 16px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
.form-ui { display: grid; gap: 14px; }
.form-ui input, .form-ui select, .form-ui textarea {
  width: 100%;
  min-height: 52px;
  padding: 14px 16px;
  border: 1px solid var(--line);
  background: rgba(251,251,248,.78);
  font: inherit;
}
.form-ui textarea { min-height: 150px; resize: vertical; }

.site-footer { background: #0d1113; color: var(--porcelain); padding: 70px 0 26px; }
.footer-grid { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; display: grid; grid-template-columns: 1.45fr 1fr .8fr .8fr 1fr; gap: 36px; }
.site-footer a { display: flex; align-items: center; gap: 8px; color: rgba(251,251,248,.76); margin: 10px 0; }
.site-footer a { transition: color .22s ease, transform .22s ease; }
.site-footer a:hover { color: var(--porcelain); transform: translateX(4px); }
.site-footer h3 { font-size: .95rem; text-transform: uppercase; letter-spacing: .1em; }
.site-footer p { color: rgba(251,251,248,.62); }
.fine { font-size: .86rem; }
.footer-disclaimer {
  width: min(var(--max), calc(100% - 40px));
  margin: 42px auto 0;
  padding: 22px 0 0;
  border-top: 1px solid rgba(255,255,255,.1);
}
.footer-disclaimer p {
  max-width: 1060px;
  margin: 0;
  font-size: .82rem;
  line-height: 1.7;
  color: rgba(251,251,248,.5);
}
.footer-bottom { width: min(var(--max), calc(100% - 40px)); margin: 44px auto 0; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.1); display: flex; justify-content: space-between; gap: 20px; color: rgba(251,251,248,.52); font-size: .9rem; }

.floating-cta {
  position: fixed;
  left: 50%;
  bottom: max(18px, env(safe-area-inset-bottom));
  z-index: 18;
  display: flex;
  gap: 8px;
  padding: 8px;
  background: rgba(13,17,19,.92);
  border: 1px solid rgba(255,255,255,.14);
  box-shadow: 0 18px 54px rgba(9,15,18,.22);
  backdrop-filter: blur(16px);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 22px);
  transition: opacity .26s ease, transform .26s ease;
}

@media (min-width: 901px) {
  .floating-cta,
  .floating-cta.is-visible {
    display: none;
  }
}

.floating-cta.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, 0);
}
.floating-cta a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 104px;
  min-height: 44px;
  padding: 0 16px;
  font-weight: 900;
}
.floating-cta__call {
  background: var(--copper);
  color: #101418;
}
.floating-cta__quote {
  background: var(--porcelain);
  color: var(--ink);
}

.cookie-banner {
  position: fixed;
  left: 50%;
  bottom: 22px;
  z-index: 24;
  width: min(960px, calc(100% - 40px));
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 22px;
  align-items: center;
  padding: 18px 18px 18px 22px;
  background: rgba(13,17,19,.96);
  color: var(--porcelain);
  border: 1px solid rgba(255,255,255,.14);
  box-shadow: 0 22px 70px rgba(9,15,18,.24);
  backdrop-filter: blur(16px);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 18px);
  transition: opacity .28s ease, transform .28s ease;
}

.cookie-banner.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, 0);
}

.cookie-banner strong {
  display: block;
  margin-bottom: 4px;
  font-size: .95rem;
}

.cookie-banner p {
  max-width: 660px;
  margin: 0;
  color: rgba(251,251,248,.7);
  font-size: .88rem;
  line-height: 1.55;
}

.cookie-banner__actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cookie-banner__actions a,
.cookie-banner__actions button {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 13px;
  border: 1px solid rgba(255,255,255,.16);
  background: transparent;
  color: var(--porcelain);
  font: inherit;
  font-size: .86rem;
  font-weight: 850;
  cursor: pointer;
  transition: background .22s ease, border-color .22s ease, transform .22s ease;
}

.cookie-banner__actions a:hover,
.cookie-banner__actions button:hover {
  transform: translateY(-2px);
  border-color: rgba(255,255,255,.34);
  background: rgba(255,255,255,.07);
}

.cookie-banner__accept {
  background: var(--copper) !important;
  border-color: var(--copper) !important;
  color: #101418 !important;
}

@media (prefers-reduced-motion: no-preference) {
  .floating-cta.is-visible .floating-cta__call svg {
    animation: phonePulse 1.8s ease-in-out infinite;
  }
}

@keyframes phonePulse {
  0%, 100% { transform: rotate(0deg) scale(1); }
  45% { transform: rotate(-8deg) scale(1.08); }
  60% { transform: rotate(6deg) scale(1.04); }
}

[data-reveal] { opacity: 1; transform: translateY(0); }

@media (prefers-reduced-motion: no-preference) {
  body.is-ready [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity .72s ease, transform .72s ease;
  }
  body.is-ready [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .desktop-nav, .nav-phone { display: none; }
  .nav-shell { grid-template-columns: 1fr auto; height: 70px; }
  .menu-toggle, .mobile-close { display: grid; place-items: center; }
  .mobile-panel {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 60;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #0d1113;
    color: var(--porcelain);
    opacity: 0;
    pointer-events: none;
    transition: opacity .28s ease;
  }
  .menu-open .mobile-panel { opacity: 1; pointer-events: auto; }
  .mobile-panel__inner {
    min-height: 100%;
    min-height: 100dvh;
    padding: 86px 20px 28px;
    display: grid;
    align-content: start;
    gap: 18px;
    transform: translateY(18px);
    transition: transform .38s ease;
  }
  .menu-open .mobile-panel__inner { transform: translateY(0); }
  .mobile-close {
    position: fixed;
    z-index: 62;
    top: 20px;
    right: 20px;
    width: 42px;
    height: 42px;
    color: var(--porcelain);
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
  }
  .mobile-kicker { color: var(--copper); text-transform: uppercase; font-weight: 900; letter-spacing: .12em; font-size: .78rem; }
  .mobile-links > a,
  .mobile-service-dropdown summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: clamp(2.05rem, 10vw, 3.2rem);
    line-height: .96;
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,.12);
    cursor: pointer;
    list-style: none;
  }
  .mobile-service-dropdown summary::-webkit-details-marker { display: none; }
  .mobile-service-dropdown summary svg {
    transition: transform .28s ease;
  }
  .mobile-service-dropdown[open] summary svg {
    transform: rotate(180deg);
  }
  .mobile-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 12px 0 16px;
  }
  .mobile-services a {
    display: flex;
    gap: 10px;
    align-items: center;
    border: 1px solid rgba(255,255,255,.12);
    padding: 13px 14px;
    background: rgba(255,255,255,.045);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: .92rem;
    font-weight: 820;
    margin: 0;
  }
  .mobile-panel .btn {
    width: 100%;
    min-height: 48px;
  }
  .mobile-panel p {
    margin: 0;
    color: rgba(251,251,248,.64);
    font-size: .94rem;
    line-height: 1.55;
  }
  .hero { min-height: auto; padding-top: 118px; }
  .hero-grid, .hero .hero-grid, .section-head, .split, .page-hero-grid, .contact-grid, .cta-band { grid-template-columns: 1fr; }
  .metric-strip, .feature-grid, .process, .method-grid, .footer-grid, .quick-intake, .quick-intake__steps { grid-template-columns: 1fr; }
  .metric { border-right: 0; border-bottom: 1px solid var(--line); }
  .metric:last-child { border-bottom: 0; }
  .section { padding: 76px 0; }
  .cta-band { padding: 34px 24px; }
  .footer-bottom { flex-direction: column; }
}

@media (max-width: 560px) {
  .container, .narrow, .footer-grid, .footer-bottom, .footer-disclaimer { width: min(var(--max), calc(100% - 28px)); }
  .lane { grid-template-columns: 48px 1fr; }
  .lane .arrow { display: none; }
  h1 { font-size: clamp(1.55rem, 7.35vw, 2.05rem); line-height: 1.08; }
  h2 { font-size: clamp(1.85rem, 8vw, 2.45rem); line-height: 1.08; }
  .hero h1 {
    max-width: 340px;
    overflow-wrap: normal;
    font-size: clamp(2.15rem, 10vw, 2.75rem);
    line-height: .98;
    text-align: center;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(246,243,238,.92);
  }
  .lead { font-size: 1rem; }
  .hero-panel {
    gap: 22px;
    width: min(100%, 340px);
    max-width: 340px;
    margin: 0 auto;
    text-align: center;
    justify-items: center;
  }
  .hero-panel .lead {
    max-width: 340px;
    color: rgba(24,32,36,.86);
    text-shadow: 0 1px 14px rgba(246,243,238,.96);
  }
  .hero-actions {
    justify-content: center;
    width: 100%;
  }
  .hero-actions .btn {
    width: auto;
    min-width: min(100%, 260px);
    max-width: 100%;
    min-height: 44px;
    padding: 0 14px;
    font-size: .92rem;
  }
  .hero-media::after {
    background:
      linear-gradient(90deg, rgba(246,243,238,.98) 0%, rgba(246,243,238,.88) 48%, rgba(246,243,238,.58) 100%),
      linear-gradient(0deg, var(--paper) 0%, rgba(246,243,238,.56) 44%, rgba(246,243,238,.2) 100%);
  }
  .hero-media img {
    object-position: 62% center;
  }
  .floating-cta {
    left: 14px;
    right: 14px;
    bottom: max(12px, env(safe-area-inset-bottom));
    transform: translateY(22px);
  }
  .floating-cta.is-visible {
    transform: translateY(0);
  }
  .floating-cta a {
    flex: 1;
    min-width: 0;
  }

  .cookie-banner {
    bottom: 12px;
    width: calc(100% - 28px);
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 16px;
  }

  .cookie-banner__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .cookie-banner__actions a {
    grid-column: 1 / -1;
  }

  .cookie-banner__actions a,
  .cookie-banner__actions button {
    width: 100%;
  }

  .cookie-banner-visible .floating-cta {
    bottom: 192px;
  }
}
